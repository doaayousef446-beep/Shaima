# Guessing Game Program in Python
import random

print("=== 🎯 لعبة تخمين الرقم 🎯 ===")
print("لقد اخترت رقماً عشوائياً بين 1 و 10. هل يمكنك تخمينه؟")

# توليد رقم عشوائي بين 1 و 10
secret_number = random.randint(1, 10)

# استقبال التخمين من المستخدم
guess = int(input("أدخل تخمينك (من 1 إلى 10): "))

# الفحص والمقارنة
if guess == secret_number:
    print("🎉 مبروك! إجابة صحيحة، لقد خمنت الرقم بنجاح!")
elif guess > secret_number:
    print(f"❌ تخمينك أكبر من الرقم المطلوب! الرقم الصحيح كان: {secret_number}")
else:
    print(f"❌ تخمينك أصغر من الرقم المطلوب! الرقم الصحيح كان: {secret_number}")
